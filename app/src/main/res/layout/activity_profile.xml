<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#3E2723"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_profile_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#E9E0C3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="My Account"
                android:textColor="#E9E0C3"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Avatar + Name -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <FrameLayout
                    android:id="@+id/btn_change_photo"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/dialog_background"
                    android:backgroundTint="#5D4037"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_menu_camera"
                        app:tint="#E9E0C3" />
                </FrameLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/button_background_circle"
                    android:backgroundTint="#E9E0C3"
                    android:padding="4dp"
                    android:src="@android:drawable/ic_input_add"
                    app:layout_constraintBottom_toBottomOf="@+id/btn_change_photo"
                    app:layout_constraintEnd_toEndOf="@+id/btn_change_photo"
                    app:tint="#3E2723" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_profile_name_top"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Resident"
                    android:textColor="#E9E0C3"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_admin_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Resident ID - #00001"
                    android:textColor="#BCAAA4"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Full Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="6dp"
            android:text="Full Name"
            android:textColor="#BCAAA4"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:letterSpacing="0.08" />

        <EditText
            android:id="@+id/et_profile_name"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/bg_signup_input"
            android:backgroundTint="#5D4037"
            android:hint="Full Name"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="#E9E0C3"
            android:textColorHint="#BCAAA4" />

        <!-- Email -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp"
            android:text="Email"
            android:textColor="#BCAAA4"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:letterSpacing="0.08" />

        <EditText
            android:id="@+id/et_profile_email"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/bg_signup_input"
            android:backgroundTint="#5D4037"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="#E9E0C3"
            android:textColorHint="#BCAAA4" />

        <!-- Phone -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp"
            android:text="Phone Number"
            android:textColor="#BCAAA4"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:letterSpacing="0.08" />

        <EditText
            android:id="@+id/et_profile_phone"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/bg_signup_input"
            android:backgroundTint="#5D4037"
            android:hint="Phone Number"
            android:inputType="phone"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="#E9E0C3"
            android:textColorHint="#BCAAA4" />

        <!-- Building (preloaded, editable) -->
        <LinearLayout
            android:id="@+id/ll_building_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_label_building"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Building"
                android:textColor="#BCAAA4"
                android:textSize="12sp"
                android:textAllCaps="true"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/tv_edit_building"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:text="✏ Edit"
                android:textColor="#E9E0C3"
                android:textSize="12sp"
                android:alpha="0.7"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp" />
        </LinearLayout>

        <AutoCompleteTextView
            android:id="@+id/actv_profile_building"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/bg_signup_input"
            android:backgroundTint="#5D4037"
            android:enabled="false"
            android:focusable="false"
            android:clickable="false"
            android:hint="Building"
            android:inputType="none"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="#E9E0C3"
            android:textColorHint="#BCAAA4" />

        <!-- Permanent Room No (preloaded, editable) -->
        <LinearLayout
            android:id="@+id/ll_room_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_label_room"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Permanent Room No."
                android:textColor="#BCAAA4"
                android:textSize="12sp"
                android:textAllCaps="true"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/tv_edit_room"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:text="✏ Edit"
                android:textColor="#E9E0C3"
                android:textSize="12sp"
                android:alpha="0.7"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp" />
        </LinearLayout>

        <EditText
            android:id="@+id/et_profile_room"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/bg_signup_input"
            android:backgroundTint="#5D4037"
            android:enabled="false"
            android:focusable="false"
            android:hint="Room Number"
            android:inputType="number"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="#E9E0C3"
            android:textColorHint="#BCAAA4" />

        <!-- Logout / Delete -->
        <TextView
            android:id="@+id/tv_logout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:padding="8dp"
            android:text="Logout"
            android:textColor="#FF5252"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_delete_account"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="8dp"
            android:text="Delete Account"
            android:textColor="#FF5252"
            android:textSize="16sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:text="App version 1.0.0"
            android:textColor="#BCAAA4"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:text="Trackie Hostels LLP"
            android:textColor="#BCAAA4"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>