<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#3E2723"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageButton
            android:id="@+id/btn_forgot_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start"
            android:background="@drawable/button_background_circle"
            android:backgroundTint="#E9E0C3"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#3E2723" />

        <TextView
            android:id="@+id/tv_forgot_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="cursive"
            android:text="Trackie"
            android:textColor="#E9E0C3"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- Container for Step 1: Find Account -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_find_account"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            app:cardBackgroundColor="#E9E0C3"
            app:cardCornerRadius="30dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:fontFamily="sans-serif-black"
                    android:text="Find your account?"
                    android:textColor="#3E2723"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="32dp"
                    android:gravity="center"
                    android:text="Enter your details to receive an OTP"
                    android:textColor="#5D4037"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Username, Email or Phone"
                    android:textColor="#3E2723"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_find_input"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="32dp"
                    android:background="@drawable/bg_signup_input"
                    android:hint="Type here..."
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:textColor="#3E2723"
                    android:textColorHint="#6D4C41" />

                <Button
                    android:id="@+id/btn_send_otp_forgot"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:backgroundTint="#3E2723"
                    android:text="Send OTP"
                    android:textColor="#E9E0C3"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:cornerRadius="25dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Container for Step 2: Reset Password (Initially Hidden) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_reset_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:visibility="gone"
            app:cardBackgroundColor="#E9E0C3"
            app:cardCornerRadius="30dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:fontFamily="sans-serif-black"
                    android:text="Verify &amp; Reset"
                    android:textColor="#3E2723"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/tv_otp_sent_to"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="24dp"
                    android:gravity="center"
                    android:text="OTP sent to your device"
                    android:textColor="#5D4037"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="6-Digit OTP"
                    android:textColor="#3E2723"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_forgot_otp"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_signup_input"
                    android:gravity="center"
                    android:hint="0 0 0 0 0 0"
                    android:inputType="number"
                    android:maxLength="6"
                    android:letterSpacing="0.5"
                    android:textColor="#3E2723"
                    android:textColorHint="#6D4C41"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="New Password"
                    android:textColor="#3E2723"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hintEnabled="false"
                    app:passwordToggleEnabled="true"
                    app:passwordToggleTint="#3E2723">

                    <EditText
                        android:id="@+id/et_new_password_forgot"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_signup_input"
                        android:hint="••••••••"
                        android:inputType="textPassword"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:textColor="#3E2723"
                        android:textColorHint="#6D4C41" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginStart="8dp"
                    android:text="Confirm New Password"
                    android:textColor="#3E2723"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hintEnabled="false"
                    app:passwordToggleEnabled="true"
                    app:passwordToggleTint="#3E2723">

                    <EditText
                        android:id="@+id/et_confirm_password_forgot"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="24dp"
                        android:background="@drawable/bg_signup_input"
                        android:hint="••••••••"
                        android:inputType="textPassword"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:textColor="#3E2723"
                        android:textColorHint="#6D4C41" />
                </com.google.android.material.textfield.TextInputLayout>

                <Button
                    android:id="@+id/btn_reset_password_final"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:backgroundTint="#3E2723"
                    android:text="Reset Password"
                    android:textColor="#E9E0C3"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:cornerRadius="25dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>