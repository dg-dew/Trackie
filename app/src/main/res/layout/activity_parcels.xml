        android:textColor="#333333"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Details coming soon..."
        android:textSize="18sp"
        android:layout_marginTop="10dp"
        android:textColor="#666666"/>

</LinearLayout>