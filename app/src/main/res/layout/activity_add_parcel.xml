<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9E0C3"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_add_parcel_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#3E2723" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Add New Parcel"
                android:textColor="#3E2723"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Form Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:cardBackgroundColor="#3E2723"
            app:cardCornerRadius="30dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Resident Name -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Resident Name"
                    android:textColor="#E9E0C3"
                    android:textStyle="bold" />

                <AutoCompleteTextView
                    android:id="@+id/actv_resident_name"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_signup_input"
                    android:completionThreshold="1"
                    android:hint="Start typing name..."
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:textColor="#3E2723"
                    android:textColorHint="#6D4C41" />

                <!-- Phone Number -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Phone Number"
                    android:textColor="#E9E0C3"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_add_phone"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_signup_input"
                    android:enabled="false"
                    android:hint="Auto-filled on name select"
                    android:inputType="phone"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:textColor="#3E2723"
                    android:textColorHint="#6D4C41" />

                <!-- Building -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Building"
                    android:textColor="#E9E0C3"
                    android:textStyle="bold" />

                <AutoCompleteTextView
                    android:id="@+id/actv_add_building"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_signup_input"
                    android:clickable="true"
                    android:focusable="false"
                    android:hint="Select Building"
                    android:inputType="none"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:textColor="#3E2723"
                    android:textColorHint="#6D4C41" />

                <!-- Room Number -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Room Number"
                    android:textColor="#E9E0C3"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_add_room"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_signup_input"
                    android:hint="Enter Room No"
                    android:inputType="number"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:textColor="#3E2723"
                    android:textColorHint="#6D4C41" />

                <!-- Date of Arrival -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Date of Arrival"
                    android:textColor="#E9E0C3"
                    android:textStyle="bold" />

                <!-- Tappable date field -->
                <LinearLayout
                    android:id="@+id/ll_date_picker"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_signup_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tv_arrival_date"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Tap to select date"
                        android:textColor="#3E2723"
                        android:textColorHint="#6D4C41"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@android:drawable/ic_menu_today"
                        app:tint="#6D4C41" />
                </LinearLayout>

                <!-- Parcel Type -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="8dp"
                    android:text="Parcel Type"
                    android:textColor="#E9E0C3"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rg_parcel_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rb_ecommerce"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="#E9E0C3"
                        android:text="e-commerce"
                        android:textColor="#E9E0C3" />

                    <RadioButton
                        android:id="@+id/rb_food"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="#E9E0C3"
                        android:text="Food items"
                        android:textColor="#E9E0C3" />

                    <RadioButton
                        android:id="@+id/rb_instants"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="#E9E0C3"
                        android:text="instants"
                        android:textColor="#E9E0C3" />

                    <RadioButton
                        android:id="@+id/rb_handle_care"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="#E9E0C3"
                        android:text="handle with care items"
                        android:textColor="#E9E0C3" />
                </RadioGroup>

                <!-- Add Button -->
                <Button
                    android:id="@+id/btn_add_parcel_final"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:backgroundTint="#E9E0C3"
                    android:text="Add"
                    android:textColor="#3E2723"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:cornerRadius="25dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>