<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9E0C3"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Photo Preview Area -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:background="#2C1810">

            <!-- Captured image -->
            <ImageView
                android:id="@+id/iv_captured_photo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <!-- Placeholder when no photo yet -->
            <LinearLayout
                android:id="@+id/ll_photo_placeholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@android:drawable/ic_menu_camera"
                    android:alpha="0.4"
                    app:tint="#E9E0C3" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="No photo yet"
                    android:textColor="#BCAAA4"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Back button -->
            <ImageButton
                android:id="@+id/btn_camera_parcel_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|start"
                android:layout_margin="12dp"
                android:background="@drawable/button_background_circle"
                android:backgroundTint="#3E2723"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#E9E0C3" />

            <!-- Retake button -->
            <LinearLayout
                android:id="@+id/btn_retake"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="16dp"
                android:background="@drawable/button_background_circle"
                android:backgroundTint="#3E2723"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@android:drawable/ic_menu_camera"
                    app:tint="#E9E0C3" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Retake"
                    android:textColor="#E9E0C3"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- "Add Details" label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="4dp"
            android:fontFamily="sans-serif-black"
            android:text="Add Details"
            android:textColor="#3E2723"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="16dp"
            android:text="Fill in the parcel info below"
            android:textColor="#6D4C41"
            android:textSize="13sp" />

        <!-- Form Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#3E2723"
            app:cardCornerRadius="28dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Resident Name -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Resident Name"
                    android:textColor="#E9E0C3"
                    android:textStyle="bold" />

                <AutoCompleteTextView
                    android:id="@+id/actv_cp_name"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_signup_input"
                    android:completionThreshold="1"
                    android:hint="Start typing name..."
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:textColor="#3E2723"
                    android:textColorHint="#6D4C41" />

                <!-- Phone -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Phone Number"
                    android:textColor="#E9E0C3"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_cp_phone"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_signup_input"
                    android:enabled="false"
                    android:hint="Auto-filled on name select"
                    android:inputType="phone"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:textColor="#3E2723"
                    android:textColorHint="#6D4C41" />

                <!-- Building -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Building"
                    android:textColor="#E9E0C3"
                    android:textStyle="bold" />

                <AutoCompleteTextView
                    android:id="@+id/actv_cp_building"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_signup_input"
                    android:clickable="true"
                    android:focusable="false"
                    android:hint="Select Building"
                    android:inputType="none"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:textColor="#3E2723"
                    android:textColorHint="#6D4C41" />

                <!-- Room -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Room Number"
                    android:textColor="#E9E0C3"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_cp_room"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_signup_input"
                    android:hint="Enter Room No"
                    android:inputType="number"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:textColor="#3E2723"
                    android:textColorHint="#6D4C41" />

                <!-- Date of Arrival -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Date of Arrival"
                    android:textColor="#E9E0C3"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/ll_cp_date"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_signup_input"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:id="@+id/tv_cp_date"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Tap to select date"
                        android:textColor="#3E2723"
                        android:textColorHint="#6D4C41"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@android:drawable/ic_menu_today"
                        app:tint="#6D4C41" />
                </LinearLayout>

                <!-- Parcel Type -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="8dp"
                    android:text="Parcel Type"
                    android:textColor="#E9E0C3"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rg_cp_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rb_cp_ecommerce"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="#E9E0C3"
                        android:text="e-commerce"
                        android:textColor="#E9E0C3" />

                    <RadioButton
                        android:id="@+id/rb_cp_food"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="#E9E0C3"
                        android:text="Food items"
                        android:textColor="#E9E0C3" />

                    <RadioButton
                        android:id="@+id/rb_cp_instants"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="#E9E0C3"
                        android:text="instants"
                        android:textColor="#E9E0C3" />

                    <RadioButton
                        android:id="@+id/rb_cp_handle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="#E9E0C3"
                        android:text="handle with care items"
                        android:textColor="#E9E0C3" />
                </RadioGroup>

                <!-- Save Button -->
                <Button
                    android:id="@+id/btn_cp_save"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:backgroundTint="#E9E0C3"
                    android:text="Save to Pending Packages"
                    android:textColor="#3E2723"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="25dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>